# Target / flash
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console on UART0, 115200
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Bluetooth: Bluedroid dual-mode (BLE + Classic + SPP)
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y

# Wi-Fi / BT coexistence
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# HTTP server WebSocket support (WEB track)
CONFIG_HTTPD_WS_SUPPORT=y

# IRAM headroom (classic ESP32 IRAM is 128 KB; with BT + Wi-Fi linked it was
# 97.6% full). Move Wi-Fi TX/RX hot paths to flash: slightly lower Wi-Fi
# throughput, irrelevant for the board's SoftAP challenges.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# HW track dev self-test (`hwdev` command, prints derived values). Keep off
# for release builds.
# CONFIG_CTF_HW_DEV=y

# --- WEB track (net mode) ---
# lwIP socket slots: main httpd (listen + ctrl + 8 clients), WEB-08 beacon
# httpd (listen + ctrl + 2), WEB-09 knock (3 UDP + door listen + 1 client)
# = 19, above the default 10.
CONFIG_LWIP_MAX_SOCKETS=20
