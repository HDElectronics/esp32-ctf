	)
	(text "CH340C at 3.3 V: V3 tied to VCC (local symbol CH340C_3V3: pin 4 typed power_in). No crystal."
		(exclude_from_sim no)
		(at 17.78 147.32 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "1775a1bc-bf9a-5f7b-879c-d376f4284d34")
	)
	(text "UART0: CH340C TXD -> U0RXD (GPIO3), RXD <- U0TXD (GPIO1). CTS/DSR/RI/DCD, R232 unused."
		(exclude_from_sim no)
		(at 17.78 151.13 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "21751491-96ef-5e08-b234-40f9a1e9ae57")
	)
	(text "Auto-reset: DTR=0 RTS=1 -> Q2 pulls EN low; DTR=1 RTS=0 -> Q3 pulls IO0 low; both equal -> released."
		(exclude_from_sim no)
		(at 129.54 251.46 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "bcb33650-84e7-5196-8eb8-b89a688ad2f2")
	)
	(text "EN RC (R10 10k + C11 1 uF) and the IO0 pull-up R11 are on the ESP32 sheet."
